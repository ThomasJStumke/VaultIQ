# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Supabase project connection.
# The anon key is safe to expose client-side -- Row Level Security policies
# (see supabase/migrations/) are the real access boundary, not this key.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: server-side only (read by server.ts, never
# VITE_-prefixed so Vite won't bundle it into client code). Powers
# /api/impersonate ("View as user" in Platform Setup > Users) -- bypasses RLS
# to verify the caller is SUPER_ADMIN and mint a session for the target user.
# Get it from Supabase Dashboard > Project Settings > API > service_role key.
# Leave unset to disable the impersonation feature (endpoint 503s).
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# SMTP Mail Server settings (Optional: falls back to system logs if not configured)
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="noreply@dut.ac.za"
SMTP_PASS="your-password"
SMTP_FROM="VaultIQ Alerts <noreply@dut.ac.za>"
