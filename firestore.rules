rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isSignedIn() && getUserData().role == role; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Faculties & Departments
    match /faculties/{facultyId} {
      allow read: if isSignedIn();
      // Only DVC or institution admins can create/update faculties (simplified for now)
      allow write: if hasRole('DVC') || hasRole('DVC_TL');
    }

    match /faculties/{facultyId}/departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if hasRole('DVC') || hasRole('DVC_TL') || hasRole('FACULTY_ADMIN');
    }

    // Modules
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole('HOD') || hasRole('FACULTY_ADMIN') || hasRole('DVC') || hasRole('DVC_TL') || hasRole('DEPUTY_DEAN') || hasRole('EXECUTIVE_DEAN');
      
      // Evidence subcollection
      match /evidence/{evidenceId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn(); // Add more strict per-module checks in production
        allow update: if hasRole('HOD') || hasRole('FACULTY_ADMIN') || hasRole('DEPUTY_DEAN') || hasRole('EXECUTIVE_DEAN');
      }
    }

    // Questionnaires (CQPA managed)
    match /questionnaires/{questionnaireId} {
      allow read: if isSignedIn();
      allow write: if hasRole('CQPA') || hasRole('FACULTY_ADMIN');
    }

    // Student & staff evaluations submissions
    match /student_evaluations/{evaluationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if hasRole('CQPA') || hasRole('FACULTY_ADMIN');
    }

    // Suggested developmental action plans
    match /development_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, create, update: if isSignedIn();
    }
  }
}
